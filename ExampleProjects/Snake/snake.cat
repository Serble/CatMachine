jmp main

#const INT_DISPLAY_MODE, 0x87
#const INT_UPDATE_SCREEN, 0x86
#const INT_UPTIME, 0x85

#const DISPLAY_MODE_BUFFER, 0x01
#const DISPLAY_MODE_TILED, 0x11
#const SCREEN_WIDTH, 512
#const SCREEN_HEIGHT, 384
#const GAME_WIDTH, 32
#const GAME_HEIGHT, 24

#const PALETTE_OFFSET, 4
#const IMAGE_OFFSET, PALETTE_OFFSET + 512
#const TILE_SCROLL_OFFSET, IMAGE_OFFSET + 32768
#const TILE_INDEX_OFFSET, TILE_SCROLL_OFFSET + 2
#const TILE_PALETTE_OFFSET, TILE_INDEX_OFFSET + 884
#const SPRITE_OFFSET, TILE_PALETTE_OFFSET + 442
#const DISPLAY_SIZE, SPRITE_OFFSET + 256

#const SPRITE_VISIBLE,     0b10000000
#const SPRITE_DRAW_BEHIND, 0b01000000
#const SPRITE_V_FLIP,      0b00100000
#const SPRITE_H_FLIP,      0b00010000

#const SNAKE_TILE, 1
#const APPLE_TILE, 2

#const TARGET_TIME, 100   ; 100ms per frame
#const EAT_GROW_AMOUNT, 3 ; grow 3 times every time you eat

; IMAGES
snake_body_image:
    dfile snake_body.bin

apple_image:
    dfile apple.bin

title_screen:
    dfile title_screen.bin

; VARIABLES
move_dir_x:
    d32 1
move_dir_y:
    d32 0

grow_count:
    d32 6

snake_length:
    d32 1

last_time:
    d32 0

last_input:
    d8 'D' ; we default to moving right, so the D input makes sense

apple_pos:
    d8 16, 16

apple_bob_pos:
    d8 0
apple_bob_count:
    d8 0

random_number:
    d16 0

; a array of body positions
; 2 bytes per body segment bc x and y pos, 32*24 is max size with 8 segments of leeway
#const snake_body_len, (GAME_WIDTH*GAME_HEIGHT + 8) * 2
snake_body:
    res8 snake_body_len

; CODE

#macro debug, 1
push r1
mov r1, $1
int 0x90
pop r1
#endmacro

main:
    ; Title screen
    mov r1, DISPLAY_MODE_BUFFER
    mov r2, title_screen
    int INT_DISPLAY_MODE
    cmp r0, 0
    jne panic
    
    int INT_UPDATE_SCREEN
    
    .press_any_key_loop:
    in r0, 0
    cmp r0, -1
    je .press_any_key_loop
    
    ; consume the rest of the input event
    in r0, 0
    in r0, 0
    
    ; change display mode because now we are loading into the game
    mov r1, DISPLAY_MODE_TILED
    mov r2, display_buffer
    int INT_DISPLAY_MODE
    cmp r0, 0
    jne panic
    
    mov r0, display_buffer
    mov @r0, 0x1e1d1d ; clear color is black
    
    ; palettes
    add r0, PALETTE_OFFSET + 4 ; skip color 0 bc it is black
    mov @r0, 0xffd4d1d1 ; white
    add r0, 4
    mov @r0, 0xffed271f ; red
    add r0, 4
    mov @r0, 0xffc5221b ; dark red
    add r0, 4
    mov @r0, 0xff543018 ; brown
    
    ; images
    mov r0, display_buffer
    add r0, IMAGE_OFFSET + 128 ; first image is blank
    cpy snake_body_image, 128
    add r0, 128
    cpy apple_image, 128
    
    ; scroll so there is 1 tile to the left and right of the screen instead of 2 tiles to the right
    mov r0, display_buffer
    add r0, TILE_SCROLL_OFFSET
    mov8 @r0, 16
    add r0, 1
    mov8 @r0, 16
    
.main_loop:
    ; timing
    int INT_UPTIME ; in r0
    mov r2, @last_time
    mov r1, r0
    add r1, TARGET_TIME ; r1 is now time to sleep until
    
    .sleep_loop:
        cmp r0, r1
        jug .exit_sleep_loop
        
        int INT_UPTIME
        jmp .sleep_loop
    .exit_sleep_loop:
    
    mov @last_time, r0
    
    call handle_input
    
    ; move snake
    mov r0, @snake_length
    sub r0, 1
    umul r0, 2 ; 2 bytes per body segment
    add r0, snake_body ; this is index for snake body
    
    ; get current head position
    mov8 r4, @r0
    mov r1, r4
    add r0, 1
    mov8 r5, @r0
    add r0, 1
    
    ; move to new position
    push r0 ; preserve r0
        mov r1, @move_dir_x            ; new pos 
        add r1, r4                     
        mov r2, 0                      ; min
        mov r3, GAME_WIDTH - 1         ; max
        call wrap_signed
        mov r4, r0
        
        mov r1, @move_dir_y            ; new pos
        add r1, r5                     
        ; mov r2, 0 ; r2 is already 0  ; min
        mov r3, GAME_HEIGHT - 1        ; max
        call wrap_signed
        mov r5, r0
        
        ; check if new pos intersects with snake
        mov r1, r4
        mov r2, r5
        call check_snake_collision
        mov r6, r0 ; move result to r6
        
        mov r2, 0  ; whether we touched apple
        
        ; if we collided with snake, jump past all remaining collision checks
        cmp r6, 0
        jne .end_collision_checks
        
        ; check if collided with apple
        mov8 r1, @apple_pos
        cmp r1, r4
        jne .end_collision_checks
        mov8 r1, [apple_pos + 1]
        cmp r1, r5
        jne .end_collision_checks
        
        ; we did collide with apple
        mov r1, @grow_count
        add r1, EAT_GROW_AMOUNT
        mov @grow_count, r1
        
        mov r2, 1 ; mark it as collided for later
        
        .end_collision_checks:
    pop r0
    
    ; add new head
    ; if collided, do not add head and subtract length by 1
    cmp r6, 0
    je .add_head_pos
        mov r1, @snake_length ; this will be compensated for later 
        sub r1, 1
        mov @snake_length, r1
        jmp .skip_adding_head
    .add_head_pos:
        mov8 @r0, r4
        add r0, 1
        mov8 @r0, r5
    .skip_adding_head:
    
    ; TODO: if they are not growing, move everything back instead of updating length
    mov r1, @grow_count
    cmp r1, 0
    jne .grow
        ; we are removing the first index, so move all data left one
        mov r0, snake_body
        cpy snake_body + 2, snake_body_len - 2 ; 2 bytes per snake part
        jmp .end_grow_if
    .grow:
        ; update length
        mov r1, @snake_length
        add r1, 1
        mov @snake_length, r1
        
        ; update grow count
        mov r1, @grow_count
        sub r1, 1
        mov @grow_count, r1
    .end_grow_if:
    
    ; place new apple if needed
    cmp r2, 0
    je .skip_move_apple
        .apple_spawn_loop:
            call rand_int
            mov r1, r0
            mov r2, GAME_HEIGHT
            udiv r1, r2
            and r1, 31 ; is like r1 % GAME_WIDTH but faster bc its and instead of div
            
            ; if apple is on snake, we try again (does not clobber r1 or r2)
            call check_snake_collision
            cmp r0, 0
            jne .apple_spawn_loop
        
        ; save new apple pos
        mov8 @apple_pos, r1
        mov8 [apple_pos + 1], r2
    .skip_move_apple:
    
    ; Draw snake
    
    ; clear current indexes
    mov r0, display_buffer
    add r0, TILE_INDEX_OFFSET
    cpy empty_for_884, 884
    
    ; iterate through snake and add tile for each position
    mov r1, snake_body    ; index
    mov r2, @snake_length ; end index
    umul r2, 2
    add r2, snake_body
    .snake_loop:
        mov8 r3, @r1 ; x pos
        add r1, 1
        mov8 r4, @r1 ; y pos
        add r1, 1
        
        mov r5, r0 ; tile index start
        add r5, r3
        umul r4, 34
        add r5, r4
        add r5, 1 + 34 ; extra offset because we want to add (1, 1) to the position bc we centered the screen with scroll
        
        mov8 @r5, SNAKE_TILE
                
        cmp r1, r2
        jul .snake_loop
    
    ; draw apple as a sprite
    mov r0, display_buffer
    add r0, SPRITE_OFFSET
    
    mov8 @r0, APPLE_TILE
    add r0, 1
    mov8 @r0, SPRITE_VISIBLE | SPRITE_DRAW_BEHIND ; attributes
    add r0, 1
    
    ; apple bob
    mov8 r2, @apple_bob_count
    mov8 r3, @apple_bob_pos
    sub r2, 1
    
    cmp r2, 6
    jige panic
    
    cmp r2, 0
    jig .skip_bob
        mov r2, 4
        
        not r3
        and r3, 1
    .skip_bob:
    
    ; put new combined apple_bob in r3
    mov8 @apple_bob_count, r2
    mov8 @apple_bob_pos, r3
    
    ; change bob position from 0 or 1 to -1 or 1
    shl r3, 1
    sub r3, 1
    
    mov8 r1, @apple_pos       ; x pos
    add r1, 1
    umul r1, 16
    mov16 @r0, r1
    add r0, 2
    
    mov8 r1, [apple_pos + 1]  ; y pos
    add r1, 1
    umul r1, 16
    add r1, r3
    mov16 @r0, r1
    
    int INT_UPDATE_SCREEN
    jmp .main_loop

; value in r1, min in r2 (inclusive), max in r3 (inclusive), result in r0
; when below r2, result is r3, when above r3 result is r2, otherwise result is r1
wrap_signed:
    cmp r1, r2
    jige .skip_less
    mov r0, r3
    ret
    .skip_less:
    
    cmp r1, r3
    jile .done
    mov r0, r2
    ret
    
    .done:
    mov r0, r1
    ret

handle_input:
    in r1, 0
    cmp r1, -1 ; is there any info
    je .done   ; if not we r done
    
    in r2, 0
    in r3, 0
    
    cmp r1, 0 ; is keyboard
    jne handle_input ; try again
    
    cmp r2, 0 ; is pressed
    jne handle_input ; try again
    
    mov8 r1, @last_input ; repeated inputs are ignored
    cmp r3, r1
    je handle_input 
    
    cmp r3, 'D'
    jne .skip_d
        cmp r1, 'A'
        je handle_input
    
        mov8 @last_input, 'D'
        mov @move_dir_x, 1
        mov @move_dir_y, 0
        jmp .done
    .skip_d:
    
    cmp r3, 'A'
    jne .skip_a
        cmp r1, 'D'
        je handle_input
        
        mov8 @last_input, 'A'
        mov @move_dir_x, -1
        mov @move_dir_y, 0
        jmp .done
    .skip_a:
    
    cmp r3, 'W'
    jne .skip_w
        cmp r1, 'S'
        je handle_input
        
        mov8 @last_input, 'W'
        mov @move_dir_x, 0
        mov @move_dir_y, -1
        jmp .done
    .skip_w:
    
    cmp r3, 'S'
    jne .skip_s
        cmp r1, 'W'
        je handle_input
        
        mov8 @last_input, 'S'
        mov @move_dir_x, 0
        mov @move_dir_y, 1
        jmp .done
    .skip_s:
    
    .done:
    ret

; check if position intersects with snake
; r1: x pos, r2: y pos (will not clobber r1 or r2 but will clobber r3)
check_snake_collision:
    push r4
    push r5
    push r6
    
    mov r0, 0             ; whether new pos collides with snake
    mov r3, snake_body    ; index
    mov r4, @snake_length
    umul r4, 2            ; 2 bytes per body segment
    add r4, snake_body    ; end index for snake
    
    ; check if collided with snake
    .collision_snake_loop:
        mov8 r5, @r3 ; x pos
        add r3, 1
        mov8 r6, @r3 ; y pos
        add r3, 1
        
        cmp r5, r1
        jne .fail_collision
        cmp r6, r2
        jne .fail_collision
        
        mov r0, 1
        jmp .end_collision_checks
        
        .fail_collision:        
        cmp r3, r4
        jul .collision_snake_loop
    .end_collision_checks:
    
    pop r6
    pop r5
    pop r4
    ret

; Mario 64 RNG method
; r0 is output random number
; automatically updates random global
rand_int:
    push r4

    mov16 r0, @random_number
    
    cmp r0, 0x560A
    jne .skip_reset_seed
        mov r0, 0
    .skip_reset_seed:
    
    mov r1, r0
    shl r1, 8
    
    xor r1, r0
    
    mov r0, r1
    and r0, 0x00ff
    shl r0, 8
    
    mov r2, r1
    and r2, 0xff00
    shr r2, 8
    
    or r0, r2
    
    shl r1, 1
    and r1, 0xffff ; make 16 bit
    xor r1, r0
    
    mov r3, r1
    shr r3, 1
    xor r3, 0xff80
    
    mov r4, r1
    and r4, 1
    cmp r4, 0
    jne .odd
    .even:
        cmp r3, 0xaa55
        jne .not_equal
            mov r0, 0
            jmp .done_odd_even
        .not_equal:
            mov r0, r3
            xor r0, 0x1ff4
            jmp .done_odd_even
    .odd:
        mov r0, r3
        xor r0, 0x8180
    .done_odd_even:
    
    mov16 @random_number, r0
    
    pop r4
    ret

panic_msg:
dstr "PANIC!\n\0"
panic:
    mov r1, panic_msg
    int 0x80
    int 0x81

empty_for_884:
    res8 884

display_buffer:
    res8 DISPLAY_SIZE
