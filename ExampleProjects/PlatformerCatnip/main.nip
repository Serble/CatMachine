#include "std"
#include "ppu"
#include "hardware"
#include "physics.nip"
#include "drawing.nip"
#include "utils.nip"

#define BACKGROUND_COLOUR, 0x365235

#define TILE_SIZE, 16
#define PPU_DEV_TYPE, 0xFF64BEF9

#define PLATFORM_IMG_INDEX, 1
#define PLAYER_IMG_INDEX, 2
#define SPIKE_IMG_INDEX, 3
#define RED_IMG_INDEX, 4

#define LEVEL_SIZE_BYTES, 768

// 16 fractional bits
#define PLAYER_SPEED, (1<<8)

// IMAGES
#binary IMAGE_PLATFORM, "data/platform.bin"
#binary IMAGE_PLATFORM_PALETTE, "data/platform.palette.bin"
#binary IMAGE_SPIKE, "data/spike.bin"
#binary IMAGE_SPIKE_PALETTE, "data/spike.palette.bin"
#binary IMAGE_PLAYER, "data/player.bin"
#binary IMAGE_PLAYER_PALETTE, "data/player.palette.bin"
#binary IMAGE_RED, "data/red.bin"
#binary IMAGE_RED_PALETTE, "data/red.palette.bin"

// levels
#binary LEVEL1, "data/levels/level1.bin"

global ppu:$PpuDevice;
global input_port:4;
global disp_buff:$TileMode;
global player_sprite_addr:4;

global current_level:1;

// fixed point numbers
// 8 fractional bits
global player_x:4;
global player_y:4;

// Q8.8
global player_vel_y:4;

// inputs
global held_left:1 = 0;
global held_right:1 = 0;
global held_up:1 = 0;

global last_jump:4 = 0;

main();


fun load_img(index:4, img_ptr:4, palette_ptr:4) {
    memcpy(disp_buff[TileMode#images][index:4, 128], img_ptr:4, 128);  // place platform image into mem
    memcpy(disp_buff[TileMode#palettes][index:4, 64], palette_ptr:4, 64);  // and its palette
}


fun main() {
    input_port:4 = find_device_port(0x2EB3AD76);  // keyboard
    let ppu_port:4 = find_device_port(${PPU_DEV_TYPE});
    init_ppu_device(ppu_port:4, ppu);

    let changemode_status:4 = set_display_mode(ppu, 0x11, disp_buff);
    if (changemode_status:4 != 0) {
        // error, i be sad
        print("Failed to initialise display buffer!");
        halt();
    }

    // okay we have a display buffer
    disp_buff:4 = ${BACKGROUND_COLOUR};
    //update_display();

    load_img(${PLATFORM_IMG_INDEX}, IMAGE_PLATFORM, IMAGE_PLATFORM_PALETTE);
    load_img(${PLAYER_IMG_INDEX}, IMAGE_PLAYER, IMAGE_PLAYER_PALETTE);
    load_img(${SPIKE_IMG_INDEX}, IMAGE_SPIKE, IMAGE_SPIKE_PALETTE);
    load_img(${RED_IMG_INDEX}, IMAGE_RED, IMAGE_RED_PALETTE);

    let player_sprite:$Sprite;
    player_sprite[Sprite#image_index]:1 = ${PLAYER_IMG_INDEX};
    player_sprite[Sprite#attributes]:1 = ${SPRITE_VISIBLE} | ${PLAYER_IMG_INDEX};
    player_sprite[Sprite#x_pos]:2 = 100;
    player_sprite[Sprite#y_pos]:2 = 100;
    memcpy(disp_buff[TileMode#sprites][0, $Sprite], player_sprite, $Sprite);
    player_sprite_addr:4 = disp_buff[TileMode#sprites][0, $Sprite];

    load_level(1);
    update_display(ppu);

    // game loop
    let target_time:4 = 0;
    while (1) {
        target_time:4 = get_uptime() + 16;  // wait 16ms
        
        // do work here
        handle_inputs();
        handle_movement();
        tick_physics();
        update_player_pos();
        update_display(ppu);

        while (get_uptime() < target_time:4) { }
    }

    update_display(ppu);
    halt();
}


fun update_player_pos() {
    (player_sprite_addr:4)[Sprite#x_pos]:2 = player_x:4 >> 8;
    (player_sprite_addr:4)[Sprite#y_pos]:2 = player_y:4 >> 8;
}


fun handle_inputs() {
    let type:4;  // 1 for down, 0 for up
    while (1) {
        let inp:4 = poll_input(input_port:4, type);
        
        switch (inp:4) {
            case ('A') {
                held_left:1 = type:4;
            }
            
            case ('D') {
                held_right:1 = type:4;
            }
            
            case ('W') {
                held_up:1 = type:4;
            }
            
            case (0xFFFFFFFF) {
                return;
            }
        }
    }
}

fun handle_movement() {
    let x_dir:4 = held_right:1 - held_left:1;  // 32bit so negatives work
    let x_offset:4 = x_dir:4 ~* ${PLAYER_SPEED};  // no shifting because x_dir isn't fixed point
    player_x:4 = player_x:4 + x_offset:4;  // move them

    // now we check if that caused a collision, if so then roll back
    if (player_collides()) {
        player_x:4 = player_x:4 - x_offset:4;
    }

    // now for vertical movement, if they are on ground and clicking jump then jump
    if (held_up:1 && is_on_ground()) {
        player_vel_y:4 = -2 << 8;
    }
}


fun die() {
    let index:4 = 0;
    while (index:4 < 884) {
        set_tile(index:4, ${RED_IMG_INDEX});
        if (index:4 % 34 == 0) {
            update_display(ppu);
            sleep(32);
        }
        index:4 = index:4 + 1;
    }
    halt();
}





