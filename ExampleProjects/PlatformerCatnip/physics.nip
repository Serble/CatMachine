

fun tick_physics() {
    // gravity
    if (!is_on_ground()) {
        player_vel_y:4 = player_vel_y:4 + (1 << 4);
    }

    // apply y velocity
    player_y:4 = player_y:4 + player_vel_y:4;
    if (player_collides()) {
        player_y:4 = player_y:4 - player_vel_y:4;
        player_vel_y:4 = 0;
    }

    // if on bottom, die
    if (player_y:4 >> 8 >= 384-16) {
        die();
    }

    if (player_touching_spike()) {
        die();  // type isnt used in methods, FIX
    }
}


// returns whether or not a point is within
// a tile in the current level.
fun point_collides(x:4, y:4, type:1) {
    let tilemap_x:2 = x:2 / ${TILE_SIZE};
    let tilemap_y:2 = y:2 / ${TILE_SIZE};

    //debug_num(LEVEL1[current_level:1-1, ${LEVEL_SIZE_BYTES}][tilemap_y:2*32+tilemap_x:2]:1);

    // return whether the current tile is a platform
    return LEVEL1[current_level:1-1, ${LEVEL_SIZE_BYTES}][tilemap_y:2*32+tilemap_x:2]:1 == type:1;
}

// returns whether the specified square is within
// a tile in the current level.
fun square_collides(x:4, y:4, width:4, height:4, type:1) {
    if (point_collides(x:2, y:2, type:1)) {
        return 1;
    }

    if (point_collides(x:2 + width:2, y:2, type:1)) {
        return 1;
    }

    if (point_collides(x:2, y:2 + height:2, type:1)) {
        return 1;
    }

    if (point_collides(x:2 + width:2, y:2 + height:2, type:1)) {
        return 1;
    }

    return 0;
}


fun player_collides() {
    return player_collides_type(1);
}


fun player_collides_type(type:1) {
    return square_collides(player_x:4 >> 8, player_y:4 >> 8, 16, 16, type:1);
}


fun player_touching_spike() {
    return player_collides_type(2);
}


// returns whether the player is current on the ground.
fun is_on_ground() {
    return square_collides(player_x:4 >> 8, (player_y:4 >> 8) + 1, 16, 16, 1);
}

