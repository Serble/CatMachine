#const APPLE_ID, 17

#const MODE_UPDATE_SCREEN, 0x01
#const MODE_DISPLAY_MODE, 0x02
#const DISPLAY_MODE_BUFFER, 0x01
#const DISPLAY_MODE_TILED, 0x11

display:
; clear color
d32 0x1e1d1d

; palettes
d32 0x00000000 ; transparent
d32 0xffd4d1d1 ; white
d32 0xffed271f ; red
d32 0xffc5221b ; dark red
d32 0xff543018 ; brown
res32 7*16+11  ; 7 unused palettes, 3 unused colors

; images, first 16 are snake pieces in special order
; 0b00                           00
;   * last snake piece direction ^ next snake piece direction
; direction is 00 left 01 right 10 up 11 down
dfile "data/snake_w"
dfile "data/snake_ew"
dfile "data/snake_nw"
dfile "data/snake_sw"

dfile "data/snake_ew"
dfile "data/snake_e"
dfile "data/snake_ne"
dfile "data/snake_es"

dfile "data/snake_nw"
dfile "data/snake_ne"
dfile "data/snake_n"
dfile "data/snake_ns"

dfile "data/snake_sw"
dfile "data/snake_es"
dfile "data/snake_ns"
dfile "data/snake_s"

; 16 snakes are over
dfile "data/snake_none" ; snake when size of 1
dfile "data/apple"

res8 128 * (256-18)   ; rest of the images are blank (256 images total)

; tile scroll
d8 0, 0

