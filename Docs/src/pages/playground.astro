---
import AssemblyPlayground from '../components/AssemblyPlayground.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Write, assemble, and run Cat Assembly entirely in your browser."
		/>
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<title>Assembly Playground | Cat Machine</title>
	</head>
	<body>
		<AssemblyPlayground />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #080c13;
	}

	html,
	body {
		margin: 0;
		min-width: 20rem;
		min-height: 100%;
	}

	body {
		overflow: hidden;
	}

	@media (max-width: 52rem) {
		body {
			overflow: auto;
		}
	}
</style>
