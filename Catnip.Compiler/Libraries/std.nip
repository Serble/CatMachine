#include "ppu"

fun debug_num(n:4) {
    ~~~r1[n:4] | | ;
    int 0x90
    ~~~
}

fun print(s:4) {
    ~~~r1[s:4] | | ;
    int 0x80
    ~~~
}

fun get_uptime() {
    ~~~ | | r1 ;
    uptms
    ~~~
    // r0 is now the uptime
    // so we can just return
}

fun memcpy(dest:4, src:4, len:4) {
    ~~~ r0[dest:4], r1[src:4], r2[len:4] | | ;
    cpy r1, r2
    ~~~
}

fun serial_in(port:4) {
     ~~~ r1[port:4] | | r1 ;
     in r0, r1
     ~~~
     // return value in r0
}

fun serial_out(port:4, data:4) {
     ~~~ r1[port:4], r2[data:4] | | r1, r2 ;
     out r1, r2
     ~~~
}
