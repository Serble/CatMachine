<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>1.0.0</Version>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>CatMachine.VM</PackageId>
        <Title>CatVM Core</Title>
        <Authors>Serble</Authors>
        <Description>CatMachine VM core library with full AOT support, supports running an application.</Description>
        <PackageProjectUrl>https://catvm.dev</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/Serble/CatMachine/raw/refs/heads/main/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/Serble/CatMachine</RepositoryUrl>
    </PropertyGroup>
</Project>
